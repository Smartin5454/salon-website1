/* =========================
   RESET & GLOBAL FIXES
========================= */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  transform: none;
}

html, body {
  font-family: 'Poppins', sans-serif;
  background-color: #faf8f6;
  color: #2c2c2c;
  overflow-x: hidden;
  writing-mode: horizontal-tb;
}

/* =========================
   COLOR VARIABLES
========================= */
:root {
  --primary: #b07a5b;
  --secondary: #1c1c1c;
  --accent: #e7c6b1;
  --light: #ffffff;
  --muted: #777;
  --border: #e0e0e0;
}

/* =========================
   HEADER
========================= */
.header {
  background: linear-gradient(135deg, #1c1c1c, #3a3a3a);
  color: #fff;
  text-align: center;
  padding: 80px 20px;
}

.header h1 {
  font-family: 'Playfair Display', serif;
  font-size: 3rem;
}

.header p {
  margin-top: 10px;
  color: #ddd;
}

/* =========================
   CONTAINER
========================= */
.container {
  max-width: 1100px;
  margin: auto;
  padding: 60px 20px;
}

/* =========================
   HEADINGS
========================= */
h2 {
  font-family: 'Playfair Display', serif;
  font-size: 2.2rem;
  margin-bottom: 30px;
  color: var(--secondary);
  text-align: center;
}

/* =========================
   ABOUT
========================= */
.about p {
  text-align: center;
  line-height: 1.8;
  color: var(--muted);
}

/* =========================
   SERVICES
========================= */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 25px;
  margin-top: 40px;
}

.service-card {
  background: #fff;
  padding: 35px;
  border-radius: 16px;
  text-align: center;
  font-size: 2rem;
  box-shadow: 0 20px 40px rgba(0,0,0,0.06);
  transition: 0.35s ease;
}

.service-card h3 {
  font-size: 1.1rem;
  margin-top: 15px;
}

.service-card:hover {
  transform: translateY(-8px);
}

/* =========================
   PRICING
========================= */
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 30px;
  margin-top: 40px;
}

.price-card {
  background: #fff;
  padding: 40px;
  border-radius: 18px;
  text-align: center;
  box-shadow: 0 20px 40px rgba(0,0,0,0.08);
}

.price-card h3 {
  margin-bottom: 10px;
}

.price {
  font-size: 2rem;
  color: var(--primary);
  margin: 20px 0;
}

/* =========================
   GALLERY
========================= */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 15px;
  margin-top: 40px;
}

.gallery-grid img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 14px;
}

/* =========================
   BOOKING FORM
========================= */
.booking-form,
.contact-form {
  max-width: 600px;
  margin: 40px auto 0;
  display: grid;
  gap: 15px;
}

.booking-form input,
.booking-form select,
.contact-form input,
.contact-form textarea {
  padding: 14px;
  border-radius: 10px;
  border: 1px solid var(--border);
  font-family: inherit;
}

.booking-form button,
.contact-form button {
  background: var(--primary);
  color: #fff;
  border: none;
  padding: 14px;
  border-radius: 30px;
  cursor: pointer;
}

/* =========================
   MAP
========================= */
.map {
  margin-top: 50px;
}

.map iframe {
  width: 100%;
  height: 350px;
  border-radius: 16px;
  border: none;
}

/* =========================
   FOOTER
========================= */
.footer {
  background: #1c1c1c;
  color: #bbb;
  text-align: center;
  padding: 25px;
}

/* =========================
   WHATSAPP FLOATING BUTTON
========================= */
.whatsapp-float {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #25d366;
  color: #fff;
  width: 55px;
  height: 55px;
  border-radius: 50%;
  font-size: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  box-shadow: 0 15px 30px rgba(0,0,0,0.3);
  z-index: 9999;
}

/* =========================
   DARK MODE
========================= */
body.dark {
  background: #0f0f0f;
  color: #e5e5e5;
}

body.dark .service-card,
body.dark .price-card {
  background: #1a1a1a;
}

body.dark .footer {
  background: #000;
}

body.dark h2 {
  color: #fff;
}

/* =========================
   MOBILE
========================= */
@media (max-width: 600px) {
  .header h1 {
    font-size: 2.2rem;
  }

  h2 {
    font-size: 1.8rem;
  }
}



