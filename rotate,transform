/* ======================================================
   GLOBAL RESET — STABILITY GUARANTEED
====================================================== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  font-family: 'Poppins', sans-serif;
  background-color: #faf8f6;
  color: #2c2c2c;
  overflow-x: hidden;
  writing-mode: horizontal-tb;
}

/* ======================================================
   COLOR SYSTEM (LUXURY SALON PALETTE)
====================================================== */
:root {
  --primary: #b07a5b;
  --primary-dark: #9b6549;
  --secondary: #1c1c1c;
  --light: #ffffff;
  --muted: #777;
  --border: #e3e3e3;
}

/* ======================================================
   TYPOGRAPHY
====================================================== */
h1, h2, h3 {
  font-family: 'Playfair Display', serif;
  color: var(--secondary);
}

p {
  line-height: 1.8;
  color: var(--muted);
}

/* ======================================================
   HEADER / HERO
====================================================== */
.header {
  background: linear-gradient(135deg, #1c1c1c, #3a3a3a);
  color: #fff;
  text-align: center;
  padding: 90px 20px;
}

.header h1 {
  font-size: 3rem;
  color: #fff;
}

.header p {
  margin-top: 12px;
  color: #ddd;
}

/* ======================================================
   LAYOUT CONTAINER
====================================================== */
.container {
  max-width: 1100px;
  margin: auto;
  padding: 70px 20px;
}

/* ======================================================
   SECTION HEADINGS
====================================================== */
.section-title {
  text-align: center;
  margin-bottom: 45px;
}

.section-title h2 {
  font-size: 2.3rem;
}

/* ======================================================
   SERVICES
====================================================== */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 28px;
}

.service-card {
  background: var(--light);
  padding: 40px 30px;
  border-radius: 18px;
  text-align: center;
  box-shadow: 0 18px 40px rgba(0,0,0,0.08);
  transition: transform 0.3s ease;
}

.service-card:hover {
  transform: translateY(-8px);
}

/* ======================================================
   PRICING
====================================================== */
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 30px;
}

.price-card {
  background: var(--light);
  padding: 45px 35px;
  border-radius: 20px;
  text-align: center;
  box-shadow: 0 20px 45px rgba(0,0,0,0.1);
}

.price {
  font-size: 2.1rem;
  color: var(--primary);
  margin: 18px 0;
}

/* ======================================================
   GALLERY
====================================================== */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.gallery-grid img {
  width: 100%;
  height: 230px;
  object-fit: cover;
  border-radius: 16px;
}

/* ======================================================
   FORMS (BOOKING & CONTACT)
====================================================== */
.form {
  max-width: 600px;
  margin: auto;
  display: grid;
  gap: 16px;
}

.form input,
.form select,
.form textarea {
  padding: 15px;
  border-radius: 10px;
  border: 1px solid var(--border);
  font-family: inherit;
}

.form button {
  background: var(--primary);
  color: #fff;
  padding: 15px;
  border-radius: 40px;
  border: none;
  cursor: pointer;
  font-size: 1rem;
}

.form button:hover {
  background: var(--primary-dark);
}

/* ======================================================
   MAP
====================================================== */
.map iframe {
  width: 100%;
  height: 360px;
  border-radius: 18px;
  border: none;
}

/* ======================================================
   CTA BUTTON
====================================================== */
.btn {
  display: inline-block;
  background: var(--primary);
  color: #fff;
  padding: 16px 45px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: 500;
}

.btn:hover {
  background: var(--primary-dark);
}

/* ======================================================
   WHATSAPP FLOATING BUTTON
====================================================== */
.whatsapp-float {
  position: fixed;
  bottom: 22px;
  right: 22px;
  width: 58px;
  height: 58px;
  background: #25d366;
  color: #fff;
  font-size: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  box-shadow: 0 15px 35px rgba(0,0,0,0.35);
  z-index: 9999;
}

/* ======================================================
   FOOTER
====================================================== */
.footer {
  background: var(--secondary);
  color: #aaa;
  text-align: center;
  padding: 30px 20px;
}

/* ======================================================
   DARK MODE (SELLING POINT)
====================================================== */
body.dark {
  background: #0f0f0f;
  color: #e5e5e5;
}

body.dark .service-card,
body.dark .price-card {
  background: #1a1a1a;
}

body.dark .footer {
  background: #000;
}

/* ======================================================
   MOBILE OPTIMIZATION
====================================================== */
@media (max-width: 600px) {
  .header h1 {
    font-size: 2.2rem;
  }

  .section-title h2 {
    font-size: 1.8rem;
  }
}



